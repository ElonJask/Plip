{
  "name": "plip",
  "productName": "Plip",
  "version": "1.0.1",
  "private": true,
  "description": "键盘按键声，常驻菜单栏与通知区域",
  "author": "怜花辞客",
  "main": "main.js",
  "scripts": {
    "test": "node run-tests.js"
  },
  "build": {
    "appId": "app.plip.mac",
    "files": [
      "main.js",
      "preload.js",
      "player-preload.js",
      "pack-path.js",
      "pack-import.js",
      "state.js",
      "mute-policy.js",
      {
        "from": "../ui",
        "to": "ui",
        "filter": [
          "*.html",
          "player-engine.js",
          "panel-ui.js"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../Soundpacks",
        "to": "Soundpacks"
      },
      {
        "from": "build",
        "to": "tray",
        "filter": [
          "tray*.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "Copyright © 2026 怜花辞客"
      },
      "target": [
        "zip"
      ],
      "artifactName": "Plip-v${version}-macos-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Plip-v${version}-windows-x64.${ext}"
    },
    "copyright": "Copyright © 2026 怜花辞客",
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "license": "MIT"
}
